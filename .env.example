# --- server ---
PORT=3000
NODE_ENV=development            # production'da haqiqiy autentifikatsiya shart (devAuth o'chadi)
DATABASE_URL=postgres://tajriba24:tajriba24@localhost:5432/tajriba24
CORS_ORIGINS=http://localhost:8081,http://localhost:5174   # veb mijoz va admin originlari
ADMIN_TOKENS={"change-me":{"id":"root","role":"administrator"}}   # vaqtinchalik; SSO/2FA ulangach olib tashlanadi
# --- test ---
TEST_DATABASE_URL=postgres://tajriba24:tajriba24@localhost:5432/tajriba24_test
# --- client (Expo, build vaqtida) ---
EXPO_PUBLIC_SERVER_URL=ws://localhost:3000
# --- admin (Vite) ---
VITE_API_URL=http://localhost:3000


# Uchta alohida manzil (DNS'da uchalasi VPS IP manziliga A-yozuv bilan ulangan bo'lishi kerak)
API_DOMAIN=api.example.uz
APP_DOMAIN=game.example.uz
ADMIN_DOMAIN=admin.example.uz
# Faqat harf va raqamdan iborat uzun parol (maxsus belgilar ulanish satrini buzadi)
POSTGRES_PASSWORD=BU-YERGA-UZUN-PAROL
# Parol menejerida yarating (32+ belgi). Kodga yoki chatga yozmang.
ADMIN_TOKENS={"BU-YERGA-UZUN-TASODIFIY-TOKEN":{"id":"root","role":"administrator"}}
METRICS_TOKEN=
# "production" haqiqiy kirish (SMS/Google/Apple) ulanmaguncha ataylab ishga tushmaydi
NODE_ENV=staging

# --- Kirish (SMS) ---
# Parol menejerida yarating: `openssl rand -hex 32`. Kamida 32 belgi. Uni almashtirsangiz hamma sessiya bekor bo'ladi.
AUTH_SECRET=
# SMS shlyuz: server POST {"to":"+998...","text":"..."} yuboradi, sarlavha `Authorization: Bearer <SMS_HTTP_TOKEN>`.
# Provayderingizning API'si boshqacha bo'lsa — `server/src/auth.ts` dagi `HttpSms` o'rniga shu provayder uchun kichik adapter yoziladi (bitta sinf).
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# Faqat sinov (staging): kodlarni jurnalga yozadi. Production'da ruxsat yo'q. Tashqi SMS yo'q paytda bu bilan sinab ko'rish mumkin.
SMS_PROVIDER=

# Google/Apple bilan kirish (ixtiyoriy; provayder konsolidan client ID oling)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=

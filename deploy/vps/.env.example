# Uchta alohida manzil (DNS'da uchalasi VPS IP manziliga A-yozuv bilan ulangan bo'lishi kerak)
API_DOMAIN=api.example.uz
APP_DOMAIN=game.example.uz
ADMIN_DOMAIN=admin.example.uz
# Baza foydalanuvchisi va nomi (yangi o'rnatishda shu qiymatlar; mavjud o'rnatishda baza yaratilgan paytdagi nomlar o'zgarishsiz qoladi)
DB_USER=tajriba24
DB_NAME=tajriba24
# Faqat harf va raqamdan iborat uzun parol (maxsus belgilar ulanish satrini buzadi)
POSTGRES_PASSWORD=BU-YERGA-UZUN-PAROL
# Parol menejerida yarating (32+ belgi). Kodga yoki chatga yozmang.
# Birinchi administrator (faqat hisob yo'q bo'lganda yaratiladi; kirgach parolni almashtirasiz va 2FA ni yoqasiz)
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_REQUIRE_2FA=1
ADMIN_TOKENS=
PAYMENT_WEBHOOK_SECRET=
METRICS_TOKEN=
# "production" haqiqiy kirish (SMS/Google/Apple) ulanmaguncha ataylab ishga tushmaydi
NODE_ENV=staging

# --- Kirish (SMS) ---
# Parol menejerida yarating: `openssl rand -hex 32`. Kamida 32 belgi. Uni almashtirsangiz hamma sessiya bekor bo'ladi.
AUTH_SECRET=
# SMS shlyuz: server POST {"to":"+998...","text":"..."} yuboradi, sarlavha `Authorization: Bearer <SMS_HTTP_TOKEN>`.
# Provayderingizning API'si boshqacha bo'lsa — `server/src/auth.ts` dagi `HttpSms` o'rniga shu provayder uchun kichik adapter yoziladi (bitta sinf).
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# Eskiz (notify.eskiz.uz): SMS_PROVIDER=eskiz va quyidagilar. Parolni faqat serverdagi .env ga yozing, repoga emas.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi nomi (Eskiz tasdiqlagan). 4546 — Eskiz sinov jo'natuvchisi: u bilan faqat sinov matnlari ketadi.
# Eskiz shablonlarni moderatsiyadan o'tkazadi: kabinetda quyidagi matnni tasdiqlatish kerak (aks holda SMS yuborilmasligi mumkin):
#   «Tajriba 24: tasdiqlash kodi {kod}. Hech kimga bermang.»   (hujjat: https://documenter.getpostman.com/view/663428/RzfmES4z)
ESKIZ_FROM=
# Faqat sinov (staging): SMS_PROVIDER=fixed — SMS yuborilmaydi, hamma uchun doimiy kod SMS_FIXED_CODE (6 raqam). Production'da ruxsat yo'q.
SMS_FIXED_CODE=
# Faqat sinov (staging): kodlarni jurnalga yozadi. Production'da ruxsat yo'q. Tashqi SMS yo'q paytda bu bilan sinab ko'rish mumkin.
SMS_PROVIDER=
# PRODUCTION (NODE_ENV=production): SMS_PROVIDER=eskiz (yuqoridagi ESKIZ_*) yoki SMS_HTTP_URL. fixed va console production'da server ishga tushishida rad etiladi (server/src/sms-select.ts).

# Google/Apple bilan kirish (ixtiyoriy; provayder konsolidan client ID oling)
GOOGLE_CLIENT_IDS=
# Google tugmasi mijozda: veb uchun OAuth client ID (GOOGLE_CLIENT_IDS ichidagi bittasi); veb qayta yig'iladi (docker compose build web). Bo'sh bo'lsa «tez orada» ko'rsatiladi.
GOOGLE_CLIENT_ID=
# Karta to'lovi (Payme, Click; Humo/Uzcard kartalari shular orqali). Kalitlar berilmaguncha to'lov yo'q. Batafsil: docs/PAYMENTS.md
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# To'lovdan keyin qaytish manzili (standart: PUBLIC_URL)
PAY_RETURN_URL=
# Email bir martalik kod: JSON {to, subject, text} qabul qiladigan xizmat. Bo'sh bo'lsa email orqali kirish yo'q.
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
APPLE_CLIENT_ID=

# Ovozli aloqa (WebRTC): STUN/TURN ro'yxati (JSON). Bo'sh qoldirilsa ommaviy STUN ishlatiladi (ba'zi tarmoqlarda ulanmaydi).
# Misol (coturn): ICE_SERVERS=[{"urls":["turn:turn.example.uz:3478","turns:turn.example.uz:5349"],"username":"tajriba24","credential":"PAROL"},{"urls":"stun:turn.example.uz:3478"}]
ICE_SERVERS=

# TURN (coturn): NAT orqasidagi o'yinchilar ovozda ulanishi uchun. Yoqish: quyidagilarni to'ldirib `docker compose --profile turn up -d turn`, so'ng serverni qayta ishga tushiring (docs/DEPLOY.md).
# TURN_SECRET — uzun tasodifiy sir (kamida 16 belgi); coturn va server bir xil qiymat ishlatadi, mijozga berilmaydi (vaqtinchalik hisob yaratiladi).
TURN_SECRET=
TURN_REALM=
TURN_EXTERNAL_IP=
# Serverga beriladigan manzillar (vergul bilan). TLS (5349) uchun domen sertifikati kerak — avval faqat turn: (3478) bilan boshlash mumkin.
TURN_URLS=
#TURN_MIN_PORT=49152
#TURN_MAX_PORT=49452

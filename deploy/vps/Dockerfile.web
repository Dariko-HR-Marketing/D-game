# Veb mijoz (Expo web) + admin panel (Vite) ni quradi va Caddy bilan statik tarqatadi.
# Server manzili build vaqtida bundlega kiradi (API_WS / API_HTTP build argumentlari).
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY rules/package.json rules/
COPY content/package.json content/
COPY server/package.json server/
COPY client/package.json client/
COPY admin/package.json admin/
RUN pnpm install --frozen-lockfile --filter @poyga/client... --filter @poyga/admin...
COPY rules rules
COPY content content
COPY client client
COPY admin admin
ARG API_WS
ARG API_HTTP
RUN test -n "$API_WS" && test -n "$API_HTTP" \
 && EXPO_PUBLIC_SERVER_URL="$API_WS" CI=1 pnpm --filter @poyga/client export:web \
 && VITE_API_URL="$API_HTTP" pnpm --filter @poyga/admin build \
 && grep -rqF "$API_WS" client/dist/_expo/static/js/web/ \
 && grep -rqF "$API_HTTP" admin/dist/assets/

FROM caddy:2
COPY --from=build /app/client/dist /srv/app
COPY --from=build /app/admin/dist /srv/admin
COPY deploy/vps/Caddyfile /etc/caddy/Caddyfile
